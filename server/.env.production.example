# ==============================================================================
# SoulTalk Pastry Server - Production Environment Configuration
# Copy this file to .env on your production server and fill in real production secrets.
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas Replica Set connection URI)
# Ensure network access whitelist permits your production server IP or VPC peering.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/soultalk?retryWrites=true&w=majority

# Authentication Secrets
# Generate random 64-character hex strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_production_jwt_access_secret_here_min_32_characters
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_here_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary CDN Asset Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Storefront Client URL (used for CORS and shareable links)
CLIENT_URL=https://soultalkpastry.com

# Global Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
